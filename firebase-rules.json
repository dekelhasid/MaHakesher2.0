{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "currentGameId": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'admin@mahakesher2nekuda0.com'"
      },
      "draft": {
        ".read": "auth != null && auth.token.email === 'admin@mahakesher2nekuda0.com'",
        ".write": "auth != null && auth.token.email === 'admin@mahakesher2nekuda0.com'"
      }
    },
    "puzzles": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@mahakesher2nekuda0.com'"
    },
    "stats": {
      "$gameId": {
        ".read": true,
        "$attemptId": {
          ".write": "auth != null && !data.exists()"
        }
      }
    },
    "players": {
      ".read": "auth != null && auth.token.email === 'admin@mahakesher2nekuda0.com'",
      "$playerName": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "feedback": {
      ".read": "auth != null && auth.token.email === 'admin@mahakesher2nekuda0.com'",
      "$feedbackId": {
        ".write": "auth != null && (!data.exists() || auth.token.email === 'admin@mahakesher2nekuda0.com')"
      }
    }
  }
}
